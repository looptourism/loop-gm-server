# انسخ هذا الملف باسم .env وعبّي القيم الحقيقية (لا ترفع .env نفسه لأي مكان عام)

# مفتاح Anthropic API — من https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# رابط الرابط الذي سيُسمح له بالاتصال بالسيرفر (رابط الواجهة الأمامية بعد نشرها)
# اتركه * مؤقتًا أثناء التطوير، وحدده لاحقًا لرابط الواجهة الفعلي
ALLOWED_ORIGIN=*

# منفذ التشغيل (تحدده منصة الاستضافة تلقائيًا غالبًا، اتركه كما هو)
PORT=3000

# تيليجرام — طلبات الموافقة بأزرار، وتنبيهات أخطاء الوكلاء
# التوكن من @BotFather (لا يُطبع في السجلات أبدًا)
TELEGRAM_BOT_TOKEN=
# رقم المحادثة الوحيدة المسموح لها بالتحكم (أي تحديث من محادثة أخرى يُتجاهل)
TELEGRAM_CHAT_ID=
# نص عشوائي طويل (A-Z a-z 0-9 _ -) يُرسل لتيليجرام مع setWebhook ويُتحقق منه في كل طلب
TELEGRAM_WEBHOOK_SECRET=
# الرابط العام للسيرفر — على Render يُؤخذ تلقائيًا من RENDER_EXTERNAL_URL فاتركه فارغًا
PUBLIC_URL=

# كلمة مرور الدخول الموحّدة — تحمي اللوحة و /office وكل مسارات /api (عدا webhook تيليجرام)
# بدونها يبقى الـ API مفتوحًا كما كان، فلا تتركها فارغة في الإنتاج
CONSOLE_PASSWORD=

# Trading Desk — eToro DEMO فقط (وحدة معزولة في مجلد trading/)
# المفتاحان من eToro: Settings ← Trading ← API Key Management (البيئة: Demo)
ETORO_API_KEY=
ETORO_USER_KEY=
# مفتاح الإيقاف: لا تُرسل أي صفقة إلا إذا كانت القيمة true بالضبط. الافتراضي false
TRADING_ENABLED=false
