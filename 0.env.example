# انسخ هذا الملف باسم .env وعبّي القيم الحقيقية (لا ترفع .env نفسه لأي مكان عام)

# مفتاح Anthropic API — من https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# رابط الرابط الذي سيُسمح له بالاتصال بالسيرفر (رابط الواجهة الأمامية بعد نشرها)
# اتركه * مؤقتًا أثناء التطوير، وحدده لاحقًا لرابط الواجهة الفعلي
ALLOWED_ORIGIN=*

# منفذ التشغيل (تحدده منصة الاستضافة تلقائيًا غالبًا، اتركه كما هو)
PORT=3000
